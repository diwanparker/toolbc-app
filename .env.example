# Local reference only. Do not bundle this file into Flutter assets.
# Production builds should pass public client config with --dart-define.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side only. Store this in Supabase Edge Function secrets, not in Flutter.
AI_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY_1=YOUR_PRIMARY_GEMINI_API_KEY
GEMINI_API_KEY_2=YOUR_BACKUP_GEMINI_API_KEY
# Optional alternative for more backups: GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.5-flash
